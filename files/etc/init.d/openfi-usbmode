#!/bin/sh /etc/rc.common
#
# openfi-usbmode —— 5G 模组的 USB 数据模式切换
#
# 【为什么开机【不】自动探测】
#   探测要逐个模式试,每次都得切模式 → 模组重新枚举 → 网络断十几秒。
#   开机时自动干这件事 = 每次启动都要断一次网,还可能因为摸不准而反复切,
#   真机上就出过"每分钟切一次、网一直被搞断"的情况。
#
#   所以现在:开机什么都不做,只在用户【主动点按钮】时才切。
#   模组出厂默认就是 RNDIS,本来就能上网 —— 不动它最稳。
#
# 【怎么用】
#   openfi-usbmode show        看当前模式
#   openfi-usbmode set 5       切到 NCM
#   openfi-usbmode set 3       切回 RNDIS
#
# 网页上:「移动网络 → 5G 模组 → USB 数据模式」那两个按钮。

START=95
STOP=14

boot() {
	# 什么都不做 —— 见上面的说明。
	#
	# 唯一做的事:如果上次切换后留下的记录还在,顺手清掉,
	# 免得 show 里那个 last_ 字段一直显示一个过期值。
	rm -f /etc/openfi_usbmode.state 2>/dev/null
	return 0
}

start() { boot; }
stop()  { return 0; }
reload() { return 0; }
