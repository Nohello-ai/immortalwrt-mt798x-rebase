#!/bin/sh
# shellcheck shell=ash
#
# ★ 目标 shell 是 busybox 的 ash(OpenWrt 的 /bin/sh),不是严格 POSIX。
#   ash 支持 `local`,所以下面那几处 SC3043("local 在 POSIX sh 里未定义")
#   在本环境下是良性的 —— 这里显式声明目标,免得每次都当问题查。
#
# openfi-usbmode —— 开机自动探测模组最佳的 USB 数据模式，并把结果锁下来。
#
# 【这个脚本放在固件里（files/），不属于任何 LuCI 包】
# 理由：它管的是"系统怎么和模组说话"，是板级行为，和界面无关；
#       放在 files/ 里能保证无论 CI 的 with_packages 开关什么状态，
#       它都一定在固件里。而且它不依赖任何包 —— 自带最小的 AT 收发，
#       只是和包里的脚本共用同一把串口锁，免得互相插话。
#
# 为什么需要它：
#   模组的 usbnet 模式决定"模组怎么把数据交给 CPU"，速度和结构差别很大：
#       5  NCM    —— 多包聚合，比 RNDIS 干净一档（仍有模组内部 NAT）
#       3  RNDIS  —— 兼容性最好、速度最差（模组出厂默认）
#   开机按 5 → 3 逐个试，哪个【真的拿到 IP 并且 ping 得通】就用哪个。
#   （MBIM 不在这条链上，理由见下面 CHAIN 那段注释。）
#
# 为什么不用 RMNET/QMI：
#   问过模组本身：AT+QCFG=? → +QCFG: "usbnet",(1,2,3,5,11,13,15)
#   列表里根本没有 0/4。RM500U-CN 是展锐平台，高通那套原生模式没实现。
#
# 安全设计（这块出错就没网）：
#   · 最后一定是 RNDIS 兜底 —— 全失败时回到和出厂一样的状态
#   · 只有【真拿到 IP 并且 ping/DNS 通】才算成功，光出现网卡不算
#   · 结果写 /etc/openfi_usbmode.state，以后开机直接用，不再折腾
#   · 失败过的模式记下来跳过，防止每次开机卡在同一个坏模式
#   · 每次开机最多切 MAX_TRIES 次，防止来回死循环
#   · 按【驱动】找网卡，不猜名字（RNDIS 叫 usb0，NCM 叫 wwan0）
#   · 切换后必须等 AT 口真的能应答 AT，才算重新枚举完成
#

# 允许覆盖：测试要指到 /tmp，绝不写真实系统
STATE="${OPENFI_USBMODE_STATE:-/etc/openfi_usbmode.state}"
TAG=openfi-usbmode

# 探测顺序：NCM(5) 优先，RNDIS(3) 兜底。
#
#   NCM   —— USB-IF 标准协议，多包聚合。比 RNDIS 干净：
#            实测 RNDIS 的 usb0 rx_errors 是 42312 且以约 200/分钟增长，
#            那是 RNDIS 私有协议本身的问题（每包一次中断、NTB 32 位）。
#            而且 NCM 保留模组内部网络栈，192.168.100.1 后台还能进。
#   RNDIS —— 兼容性最好、实测能跑，放最后当保险。
#            只有 NCM 验证失败时才会用到，而且有 7 天失败记忆。
#
# 【不含 MBIM(2)】：它在 OpenWrt 里是"调制解调器"模型 —— 要 umbim
# 守护进程、uci 里要写字符设备 /dev/cdc-wdmN，而且会让模组内部网络栈
# 失效（后台进不去）。唯一收益是少一层 NAT，而那一层只值 1.3ms
# （HNAT 早就卸载到硬件了）。收益≈0、代价实打实，所以从主线拿掉了。
# 完整实现（含 wdm 字符设备的查找、以及配套的 13 项回归测试）在
# mbim-archive 分支上，以后要用再去取。
#
# 【不含 ECM(1)】：ECM 和 NCM 属同一类 CDC 以太网协议，NCM 起不来的
# 场合 ECM 基本也起不来。而且实测这台模组的 usbnet 支持
# 1/2/3/5/11/13/15，NCM 本来就在列表里。
# 探测顺序:先试 NCM(更快更干净),不通再退回 RNDIS。
# ★ 这个变量在脚本正文里【不再被引用】—— 但不要删:
#   tests/test-usbmode.sh 会断言它等于 "5 3",它是"我们支持的顺序"
#   这件事的唯一声明处。删掉测试就失去基准了。
# shellcheck disable=SC2034
CHAIN="5 3"

REENUM_WAIT=60			# 等 USB 重新枚举 + AT 口复活的上限（秒）

log() { logger -t "$TAG" "$*"; }

mode_name() {
	case "$1" in
		0) echo RMNET ;;  1) echo ECM ;;
		3) echo RNDIS ;;  4) echo QMI ;;   5) echo NCM ;;
		*) echo "未知($1)" ;;
	esac
}

mode_driver() {
	case "$1" in
		1) echo cdc_ether ;;	# ECM
		3) echo rndis_host ;;	# RNDIS
		5) echo cdc_ncm ;;	# NCM
		*) echo "" ;;
	esac
}

mode_proto() {
	# 链里只剩 NCM/RNDIS，都是标准网卡模型 → 一律 dhcp。
	# 保留这个函数是因为调用点有好几处，以后要接别的 proto 也方便。
	echo dhcp
}

# ================================================================ 串口
#
# 【为什么不再自己实现一套 shell 串口收发】
#   之前用 stty + printf + cat 那套,真机上读不到模组回应
#   (stty 失败会兜底成 true,cat 就阻塞到超时,什么都读不到),
#   表现是"当前模式: 未知"+"切换命令被拒"。
#   而 luci-app-openfi-modem 那个 C 工具【实测能正常收发】,
#   所以这里直接复用它,不再自己造一遍。
#
#   顺带解决了抢串口的问题:它内部用同一把锁,和采样进程互斥。

MODEM_BIN="${OPENFI_MODEM_BIN:-/usr/sbin/openfi-modem}"

# 发一条 AT,输出模组的原始回应
at_send() {
	if [ -x "$MODEM_BIN" ]; then
		"$MODEM_BIN" at "$1" 2>/dev/null
		return $?
	fi
	return 1
}

# 读当前 usbnet 模式(数字)
at_get_mode() {
	at_send 'AT+QCFG="usbnet"' 2>/dev/null \
		| sed -n 's/.*"usbnet",\([0-9]*\).*/\1/p' | head -1
}

# 切模式。成功 0,失败 1
at_set_mode() {
	case "$(at_send "AT+QCFG=\"usbnet\",$1" 2>/dev/null)" in
		*OK*) return 0 ;;
		*)    return 1 ;;
	esac
}

# 等 USB 重新枚举 + AT 口复活
wait_at_alive() {
	local i=0
	while [ "$i" -lt "$((REENUM_WAIT / 2))" ]; do
		case "$(at_send 'AT' 2>/dev/null)" in
			*OK*) return 0 ;;
		esac
		sleep 2
		i=$((i + 1))
	done
	return 1
}

# ================================================================ 探测

# 切 usbnet 之后模组整个重新枚举，ttyUSB* 会消失再出现 ——
# 必须等它真能应答 AT 才算切换完成，否则后面的操作全是白做。
# 按驱动找网卡，不猜名字



# 真拉起网络并验连通 —— 网卡出现不代表能上网
# （没插卡/欠费/模组假死时网卡照样在、IP 也照样有，这正是 wancheck 要解决的问题）

# ================================================================ 状态
state_get() {
	[ -f "$STATE" ] || return 1
	sed -n "s/^$1=//p" "$STATE" 2>/dev/null | head -1
}


state_set() { # $1=mode $2=dev $3=proto [$4=失败列表]
	local failed
	failed="${4:-$(state_get failed)}"
	# 【坑】这里不能用 `[ -n "$failed" ] && echo ...` 收尾：
	# 条件为假时整个 { } 块返回非零，后面的 && mv 就被短路跳过了，
	# 状态文件永远不落地 —— 而且不报任何错，最难查的那种。
	# 拆成两段：先无条件写完，再单独判断。
	{
		echo "mode=$1"
		echo "dev=$2"
		echo "proto=$3"
		echo "ts=$(date +%s)"
		if [ -n "$failed" ]; then
			echo "failed=$failed"
		fi
	} > "$STATE.tmp" || return 1
	mv "$STATE.tmp" "$STATE"
}

# ================================================================ 命令
#
# 【设计取舍】只保留两个动作:show / set
#
#   之前有 auto/start/status/reset 一整套(自动探测 + 进度轮询),
#   真机上出了两个大问题:
#     ① auto 要逐个模式试,每次都切模式 → 必然断网;
#        做成网页按钮,用户一点就断网,而且不知道要等多久。
#     ② 跑完被反复拉起,每分钟切一次模式 → 网一直被它搞断。
#
#   现在改成【手动、立即返回】:
#     show       看当前模式
#     set N      发一条切换命令就返回(不等 USB 重新枚举)
#   断网是必然的(切模式就要重新枚举),所以界面上明确提示,
#   由用户自己决定什么时候切、切完自己确认。
#
case "${1:-show}" in
show)
	m="$(at_get_mode)"
	if [ -n "$m" ]; then
		echo "mode=$m"
		echo "name=$(mode_name "$m")"
		echo "iface=$(mode_driver "$m")"
	else
		echo "mode="
		echo "name=未知"
		echo "iface="
	fi
	if [ -f "$STATE" ]; then
		sed -n 's/^/last_/p' "$STATE"
	fi
	;;

set)
	target="$2"
	case "$target" in
		1|3|5) ;;
		*) echo "用法: openfi-usbmode set {1|3|5}   (1=ECM 3=RNDIS 5=NCM)" >&2; exit 1 ;;
	esac

	cur="$(at_get_mode)"
	if [ "$cur" = "$target" ]; then
		echo "已经是 $(mode_name "$target") 了,不用切"
		exit 0
	fi

	echo "正在切到 $(mode_name "$target")…"

	if ! at_set_mode "$target"; then
		echo "切换命令被模组拒绝(可能不支持这个模式)" >&2
		exit 1
	fi

	state_set "$target" "" "$(mode_proto "$target")" 2>/dev/null || true

	# ★★★ 关键一步:光改 AT+QCFG="usbnet",N 是【不生效】的。
	#
	#   真机上验证过:发完 usbnet 命令后,模组照旧用原来的驱动
	#   (usb0 的驱动还是 rndis_host,MAC 也没变),
	#   必须让它重新枚举一次,新配置才会应用。
	#
	#   这台模组(RM500U-CN)没有单独的"重新枚举"AT 命令,
	#   用 AT+CFUN=1,1(重启模组)让它重新枚举 —— 实测有效:
	#   重启后 usb0 的驱动从 rndis_host 变成 cdc_ncm,网也正常恢复。
	#
	#   代价:模组重启期间(约 30~60 秒)没网,这是切模式不可避免的。
	echo "正在重启模组让它按新模式重新枚举(约 30~60 秒没网)…"
	at_send 'AT+CFUN=1,1' >/dev/null 2>&1

	echo "已切换。模组正在重新枚举,网络会在 30~60 秒内恢复,之后刷新页面。"
	exit 0
	;;

--library) : ;;
*)
	echo "用法: openfi-usbmode {show|set {1|3|5}}" >&2
	exit 1
	;;
esac
