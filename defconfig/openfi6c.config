#
# ── OpenFi 6C 自己的包(源码在 package/openfi/ 下,不走 feed)──────────
#   openfi-lib 是三个包共用的库,会被依赖自动带进来,不用显式选。
#   风扇那包还装了 /etc/rc.button/config(物理开关)和 /etc/init.d/openfi-fan。
#
CONFIG_PACKAGE_luci-app-openfi-fan=y
CONFIG_PACKAGE_luci-app-openfi-modem=y
