#!/bin/sh /etc/rc.common
# shellcheck disable=SC2034  # START/STOP/USE_PROCD 由 /etc/rc.common 读取
#
# OpenFi 6C 风扇温控守护进程
#
# START=95:排在网络之后、/etc/init.d/led(START=96)之前 ——
# 先让风扇转起来(散热优先),再配灯。
#
START=95
STOP=12
USE_PROCD=1

start_service() {
	procd_open_instance
	procd_set_param command /usr/sbin/openfi-fan
	# 崩了就拉起来;5 秒内最多重启 10 次,再不行就放弃(免得疯狂重启刷日志)
	procd_set_param respawn 3600 5 10
	# 配置文件变了就自动 restart
	# ★ 不要 procd_set_param file /etc/config/openfi:
	#   下面已经用 procd_add_reload_trigger 注册了同一个文件的变更。
	#   两个机制同时挂一个文件,提交配置时会既重启实例又发 HUP,
	#   "原地重读、风扇不停"就落空了。只保留 reload trigger。
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_close_instance
}

reload_service() {
	# SIGHUP 让守护进程原地重读配置,不用停风扇
	procd_send_signal openfi-fan '*' HUP
}

service_triggers() {
	procd_add_reload_trigger openfi
}
