#!/bin/sh
#
# 首次启动写入默认风扇配置。
# 只在配置缺失时写 —— 升级固件不会覆盖用户调过的曲线。
#
[ -f /etc/config/openfi_fan ] && uci -q get openfi_fan.fan >/dev/null && exit 0

# ★ 必须先让配置文件存在。
#   新版 uci(25.12 / 内核 6.18 那一代)的 `set` 【不会】自动创建配置文件:
#   对不存在的配置名执行 uci set 会直接报 "Entry not found" 并返回 1 ——
#   实测在 OpenWrt SNAPSHOT r36806 上就是这个行为。
#   旧的 24.10 会自动建,所以这条在老固件上看着没事,换到新固件就整段失效。
: >> /etc/config/openfi_fan

uci -q batch <<-EOC
	set openfi_fan.fan=fan
	set openfi_fan.fan.mode='auto'
	set openfi_fan.fan.period='5'
	set openfi_fan.fan.min_speed='10'
	set openfi_fan.fan.temp1='55'
	set openfi_fan.fan.temp2='58'
	set openfi_fan.fan.temp3='61'
	set openfi_fan.fan.temp4='65'
	set openfi_fan.fan.speed1='30'
	set openfi_fan.fan.speed2='50'
	set openfi_fan.fan.speed3='80'
	set openfi_fan.fan.speed4='100'
	set openfi_fan.fan.emergency_temp='85'
	set openfi_fan.fan.silent_max_temp='75'
	set openfi_fan.fan.silent_when_hi='1'
	set openfi_fan.fan.wifi_iface='ra0'
	set openfi_fan.fan.wifi_temp='1'
	commit openfi_fan
EOC

exit 0
