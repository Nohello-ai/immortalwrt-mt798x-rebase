#!/bin/sh /etc/rc.common
# shellcheck disable=SC2034  # START/STOP/USE_PROCD 由 /etc/rc.common 读取
#
# OpenFi 6C 短信收取服务
#
# START=96:排在模组采样之后(那个会把 AT 口用着,不过两边都是短暂持有,
# 冲突时各自重试即可)。
#
START=96
STOP=11
USE_PROCD=1

start_service() {
	procd_open_instance
	procd_set_param command /usr/bin/openfi-sms collect
	procd_set_param respawn 3600 5 10
	procd_set_param file /etc/config/openfi_sms
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_close_instance
}

reload_service() {
	procd_send_signal openfi-sms '*' HUP
}

service_triggers() {
	procd_add_reload_trigger openfi_sms
}
