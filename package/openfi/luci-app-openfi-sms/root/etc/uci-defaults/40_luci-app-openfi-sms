#!/bin/sh
#
# 首次启动写入默认短信配置。
#
# ★ 必须先让配置文件存在:新版 uci(OpenWrt 25.12 那一代)的 set
#   不会自动创建配置文件,对不存在的名字会直接报 "Entry not found"。
#   这一点是在真机(OpenWrt SNAPSHOT)上测出来的,旧版本没这个问题。
#
[ -f /etc/config/openfi_sms ] && uci -q get openfi_sms.sms >/dev/null && exit 0

: >> /etc/config/openfi_sms

uci -q batch <<-EOC
	set openfi_sms.sms=sms
	set openfi_sms.sms.at_port=''
	set openfi_sms.sms.sca=''
	set openfi_sms.sms.baud='115200'
	set openfi_sms.sms.timeout_ms='2000'
	set openfi_sms.sms.period='20'
	set openfi_sms.sms.max_store='500'
	commit openfi_sms
EOC

exit 0
