#!/bin/sh /etc/rc.common
# shellcheck disable=SC2034  # START/STOP/USE_PROCD 由 /etc/rc.common 读取
#
# OpenFi 6C 模组采样服务
#
# START=94:排在风扇(95)之前 —— 风扇要用这里写出来的模组温度,
# 先让它开始采样,风扇启动时就有温度可读。
#
START=94
STOP=13
USE_PROCD=1

start_service() {
	procd_open_instance
	procd_set_param command /usr/sbin/openfi-modem collect
	procd_set_param respawn 3600 5 10
	procd_set_param file /etc/config/openfi_modem
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_close_instance
}

reload_service() {
	# 采样进程收到 HUP 就退出重来(procd 会拉起),等于重新探一次 AT 口
	procd_send_signal openfi-modem '*' HUP
}

service_triggers() {
	procd_add_reload_trigger openfi_modem
}
